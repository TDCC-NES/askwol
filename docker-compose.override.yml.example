# Development override: bind-mount src/ and run uvicorn with --reload.
# Copy to docker-compose.override.yml to enable automatic Compose merging.
# This .example file is inactive and can stay on production servers.
services:
  askwol:
    volumes:
      # Mount source code so edits on the host are picked up instantly.
      - ./src:/app/src:ro
    command:
      - uvicorn
      - askwol.web:app
      - --host
      - 0.0.0.0
      - --port
      - "8000"
      - --reload
      - --reload-dir
      - /app/src
